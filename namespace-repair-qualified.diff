+        if other == namespace {
+            continue;
+        }
+        match code.resolve_import_from_item_at(owner, byte, &text, other) {
+            Ok(_) => return Ok(false),
+            Err(CodeResolveError::Resolve(ResolveError::NotFound(_))) => {}
+            Err(error) => return Err(error),
+        }
+    }
