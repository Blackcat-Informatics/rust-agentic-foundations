+fn debt_groups(census: &Census) -> Result<BTreeSet<DebtGroup>, Error> {
+    census
+        .groups()
+        .iter()
+        .map(|group| {
+            let mut counts = BTreeMap::new();
+            for symbol in group.member_symbols() {
+                *counts.entry(symbol.to_owned()).or_default() += 1;
