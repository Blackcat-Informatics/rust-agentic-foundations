+        Location::Section(value) => add(graph, id, "section", Atom::string(value))?,
+        Location::Key(value) => add(graph, id, "key", Atom::string(value))?,
+        Location::Document => {}
+        _ => return Err(Error::Value("unsupported finding location".into())),
