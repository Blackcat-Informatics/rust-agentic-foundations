+fn pinned(name: &str, graph: &Graph) {
+    let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures/reports");
+    for (suffix, format) in [("ttl", Format::Turtle), ("nt", Format::NTriples)] {
