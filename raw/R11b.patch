+                    [[bin]]\nname = \"x\"\nrequired-features = [\"cli\"]\ntest = false\n\
+                    [[test]]\nname = \"it\"\nharness = false\ntest = false\n\
+                    [[bench]]\nname = \"b\"\nharness = false\ntest = true\n\
+                    [[example]]\nname = \"e\"\nrequired-features = [\"a\", \"b\"]\ndoctest = true\n";
+    let ws = load(
