+            ResolveError::Ambiguous(vec![ItemId(0), ItemId(1)]),
+            ResolveError::Cyclic(hostile()),
+            ResolveError::Invalid(hostile()),
+            ResolveError::UnresolvedSelf(hostile()),
+            ResolveError::UnknownPackage(hostile()),
+            ResolveError::UnresolvedGlob {
