+                | ResolveError::Ambiguous(_)
+                | ResolveError::Cyclic(_)
+                | ResolveError::Invalid(_)
+                | ResolveError::UnresolvedSelf(_)
+                | ResolveError::UnknownPackage(_)
+                | ResolveError::UnresolvedGlob { .. } => {}
+            }
+        }
