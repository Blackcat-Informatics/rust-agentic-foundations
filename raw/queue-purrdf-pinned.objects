use super::{ErrorKind, Limits, read, read_with, write};
use crate::json::{self, Object, Value};

fn kind(text: &str) -> ErrorKind {
    read(text).expect_err(text).kind()
}

fn json(text: &str) -> Value {
    json::read(text).expect("a JSON fixture")
}

