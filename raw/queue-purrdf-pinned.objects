        "i_string_1st_surrogate_but_2nd_missing.json",
        false,
        "unpaired surrogate escape",
    ),
    (
        "i_string_1st_valid_surrogate_2nd_invalid.json",
        false,
        "unpaired surrogate escape",
    ),
    (
        "i_string_incomplete_surrogate_and_escape_valid.json",
