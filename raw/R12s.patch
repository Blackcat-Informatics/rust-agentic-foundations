index 0000000..926ed77
--- /dev/null
+++ crates/raf-source/tests/load_cap.rs
@@ -0,0 +1,146 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
+// SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+//! The byte cap on a file, judged through `Workspace::load` rather than a bare
+//! read: a module file of exactly the default cap loads, one byte more is
+//! refused naming the file and the limit, and a cap lowered in the options
+//! applies to a file the module walk reaches. The files are padded with
+//! comments, so they are valid Rust that costs the parser almost nothing.
+
+use raf_source::{
+    DEFAULT_MAX_FILE_BYTES, LoadError, LoadErrorKind, LoadOptions, MemoryTree, Tree, TreeError,
+    Workspace,
+};
+
+const DEMO: &str = "[package]\nname = \"demo\"\nversion = \"0.1.0\"\nedition = \"2021\"\n";
+
+/// `head` followed by comment lines, `len` bytes in all.
+fn padded_to(head: &str, len: usize) -> String {
+    let mut text = String::with_capacity(len);
+    text.push_str(head);
+    while text.len() + 80 < len {
+        text.push_str("//");
+        text.push_str(&"x".repeat(77));
+        text.push('\n');
+    }
+    // The rest is one comment line of the exact remaining length, without
+    // its final newline when only one byte is left.
+    let rest = len - text.len();
+    match rest {
+        0 => {}
+        1 => text.push('\n'),
+        _ => {
+            text.push_str("//");
+            text.push_str(&"y".repeat(rest - 3));
+            text.push('\n');
+        }
+    }
+    assert_eq!(text.len(), len);
+    text
+}
+
+fn cap() -> usize {
+    usize::try_from(DEFAULT_MAX_FILE_BYTES).expect("the cap fits")
+}
+
+fn load(files: &[(&str, &str)], options: &LoadOptions) -> Result<Workspace, LoadError> {
+    let mut all = vec![("Cargo.toml", DEMO)];
+    all.extend_from_slice(files);
+    let tree: MemoryTree = all.into_iter().collect();
+    Workspace::load_with(&tree, &["."], options)
+}
+
+fn too_large(error: &LoadError) -> Option<u64> {
+    match &error.kind {
+        LoadErrorKind::Tree(inner) => match **inner {
+            TreeError::TooLarge { limit, .. } => Some(limit),
+            _ => None,
+        },
+        _ => None,
+    }
+}
+
+#[test]
+fn a_library_root_of_exactly_the_cap_loads_and_one_byte_more_is_refused_naming_it() {
+    let at = padded_to("pub fn at_cap() {}\n", cap());
+    let ws = load(&[("src/lib.rs", &at)], &LoadOptions::default()).expect("at the cap");
+    assert!(ws.resolve("demo::at_cap").is_ok());
+
+    let over = padded_to("pub fn over_cap() {}\n", cap() + 1);
+    let error = load(&[("src/lib.rs", &over)], &LoadOptions::default()).expect_err("one over");
+    assert_eq!(too_large(&error), Some(DEFAULT_MAX_FILE_BYTES), "{error}");
+    assert_eq!(error.file.as_str(), "src/lib.rs");
+    assert!(error.to_string().contains("src/lib.rs"), "{error}");
+}
+
+#[test]
+fn a_module_file_of_exactly_the_cap_loads_and_one_byte_more_is_refused_naming_it() {
+    let lib = "pub mod child;\n";
+    let at = padded_to("pub fn at_cap() {}\n", cap());
+    let ws = load(
+        &[("src/lib.rs", lib), ("src/child.rs", &at)],
+        &LoadOptions::default(),
+    )
+    .expect("at the cap");
+    assert!(ws.resolve("demo::child::at_cap").is_ok());
+
+    let over = padded_to("pub fn over_cap() {}\n", cap() + 1);
+    let error = load(
+        &[("src/lib.rs", lib), ("src/child.rs", &over)],
+        &LoadOptions::default(),
+    )
+    .expect_err("one over");
+    assert_eq!(too_large(&error), Some(DEFAULT_MAX_FILE_BYTES), "{error}");
+    assert_eq!(
+        error.file.as_str(),
+        "src/lib.rs",
+        "the declaring file: {error}"
+    );
+    assert_eq!(error.line, Some(1), "{error}");
+    assert!(error.to_string().contains("src/child.rs"), "{error}");
+}
+
+#[test]
+fn a_lowered_cap_applies_to_a_child_file_and_spares_a_root_within_it() {
+    let lib = "pub mod child;\n";
+    let child = padded_to("pub fn small() {}\n", 1000);
+    let mut options = LoadOptions::default();
+    options.max_file_bytes = 1000;
+    let ws = load(&[("src/lib.rs", lib), ("src/child.rs", &child)], &options)
+        .expect("the child is exactly the lowered cap");
+    assert!(ws.resolve("demo::child::small").is_ok());
+
+    let child = padded_to("pub fn small() {}\n", 1001);
+    let error = load(&[("src/lib.rs", lib), ("src/child.rs", &child)], &options)
+        .expect_err("one over the lowered cap");
+    assert_eq!(too_large(&error), Some(1000), "{error}");
+    assert_eq!(
+        error.file.as_str(),
+        "src/lib.rs",
+        "the declaring file: {error}"
+    );
+    assert_eq!(error.line, Some(1), "{error}");
+    assert!(error.to_string().contains("src/child.rs"), "{error}");
+}
+
+#[test]
+fn a_cap_larger_than_the_default_admits_a_file_the_default_refuses() {
+    let big = padded_to("pub fn big() {}\n", cap() + 1);
+    let mut options = LoadOptions::default();
+    options.max_file_bytes = DEFAULT_MAX_FILE_BYTES + 1;
+    let ws = load(&[("src/lib.rs", &big)], &options).expect("within the raised cap");
+    assert!(ws.resolve("demo::big").is_ok());
+}
+
+#[test]
+fn the_memory_tree_used_here_reads_the_padded_file_at_its_exact_size() {
+    let text = padded_to("", cap());
+    let tree: MemoryTree = [("a.rs", text.as_str())].into_iter().collect();
+    let read = tree
+        .read(
+            &raf_source::RelPath::new("a.rs").expect("path"),
+            DEFAULT_MAX_FILE_BYTES,
+        )
+        .expect("reads");
+    assert_eq!(read.len(), cap());
+}
diff --git crates/raf-source/tests/source_text.rs crates/raf-source/tests/source_text.rs
new file mode 100644
index 0000000..0554bc3
--- /dev/null
+++ crates/raf-source/tests/source_text.rs
@@ -0,0 +1,142 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
+// SPDX-License-Identifier: MIT OR Apache-2.0 OR MulanPSL-2.0
+
+//! The text of a module file as `Workspace::load` meets it: a file that is not
+//! UTF-8 is refused naming it, and a byte-order mark or CRLF line endings leave
+//! every line number and byte span exactly where they are in the text.
+
+mod support;
+
+use std::fs;
+
+use raf_source::{
+    Budget, DiskTree, Item, LoadError, LoadErrorKind, LoadOptions, MemoryTree, RelPath, Tree,
+    TreeError, Workspace,
+};
+
+const DEMO: &str = "[package]\nname = \"demo\"\nversion = \"0.1.0\"\nedition = \"2021\"\n";
+const BOM: &str = "\u{feff}";
+
+fn load(lib: &str) -> Result<Workspace, LoadError> {
+    let tree: MemoryTree = [("Cargo.toml", DEMO), ("src/lib.rs", lib)]
+        .into_iter()
+        .collect();
+    Workspace::load(&tree, &["."])
+}
+
+fn item<'w>(ws: &'w Workspace, path: &str) -> &'w Item {
+    let resolved = ws.resolve(path).unwrap_or_else(|error| panic!("{error}"));
+    ws.item(resolved.sites[0]).expect("the item")
+}
+
+/// The text a span covers in the file the workspace holds.
+fn covered<'w>(ws: &'w Workspace, item: &Item) -> &'w str {
+    let text = ws.source(&item.file).expect("the file's text");
+    &text[item.span.start_byte..item.span.end_byte]
+}
+
+/// `a` on line 2, `b` on lines 4 to 5, whatever the line endings, with a
+/// non-ASCII character before `b` to move bytes from columns.
+fn body(nl: &str) -> String {
+    format!("// caf\u{e9}{nl}pub fn a() {{}}{nl}{nl}pub fn b() {{{nl}}}{nl}")
+}
+
+fn check_lines(ws: &Workspace) {
+    let (a, b) = (item(ws, "demo::a"), item(ws, "demo::b"));
+    assert_eq!((a.name_line, a.span.start_line, a.span.end_line), (2, 2, 2));
+    assert_eq!((b.name_line, b.span.start_line, b.span.end_line), (4, 4, 5));
+    assert_eq!(covered(ws, a), "pub fn a() {}");
+    assert!(covered(ws, b).starts_with("pub fn b() {") && covered(ws, b).ends_with('}'));
+}
+
+#[test]
+fn crlf_line_endings_give_the_same_lines_and_spans_as_lf() {
+    for newline in ["\n", "\r\n"] {
+        let ws = load(&body(newline)).expect("loads");
+        check_lines(&ws);
+    }
+}
+
+#[test]
+fn a_byte_order_mark_leaves_the_lines_of_the_text_where_they_are() {
+    for newline in ["\n", "\r\n"] {
+        let ws = load(&format!("{BOM}{}", body(newline))).expect("loads with a BOM");
+        check_lines(&ws);
+    }
+}
+
+#[test]
+fn a_syntax_error_in_a_crlf_file_or_after_a_byte_order_mark_names_its_own_line() {
+    for text in [
+        "fn ok() {}\n\nfn 1 {}\n",
+        "fn ok() {}\r\n\r\nfn 1 {}\r\n",
+        &format!("{BOM}fn ok() {{}}\n\nfn 1 {{}}\n"),
+        &format!("{BOM}fn ok() {{}}\r\n\r\nfn 1 {{}}\r\n"),
+    ] {
+        let error = load(text).expect_err("syntax error");
+        assert_eq!(error.line, Some(3), "{text:?}: {error}");
+        assert!(
+            matches!(error.kind, LoadErrorKind::Syntax { .. }),
+            "{error}"
+        );
+        assert_eq!(error.file.as_str(), "src/lib.rs");
+    }
+}
+
+#[test]
+fn a_budget_refusal_in_a_crlf_file_names_the_same_line_as_in_an_lf_file() {
+    // The delimiter budget is refused at the 129th open parenthesis, on line 4.
+    let nested = format!("{}{}", "(".repeat(129), ")".repeat(129));
+    for nl in ["\n", "\r\n"] {
+        let text = format!("fn a() {{}}{nl}{nl}{nl}const C: () = {nested};{nl}");
+        let error = load(&text).expect_err("over the budget");
+        assert!(
+            matches!(
+                error.kind,
+                LoadErrorKind::Budget {
+                    budget: Budget::Delimiters,
+                    ..
+                }
+            ),
+            "{error}"
+        );
+        assert_eq!(error.line, Some(4), "{nl:?}: {error}");
+    }
+}
+
+#[test]
+fn a_module_file_that_is_not_utf8_is_refused_on_disk_naming_the_file() {
+    let scratch = support::Scratch::new();
+    scratch.dir("root/src");
+    scratch.file("root/Cargo.toml", DEMO);
+    scratch.file("root/src/lib.rs", "pub mod child;\n");
+    // A lone continuation byte is not UTF-8, in a comment that would parse.
+    let mut bytes = b"// caf".to_vec();
+    bytes.extend_from_slice(&[0xe9, b'\n']);
+    bytes.extend_from_slice(b"pub fn f() {}\n");
+    fs::write(scratch.path("root/src/child.rs"), &bytes).expect("write");
+
+    let tree = DiskTree::new(scratch.path("root")).expect("tree");
+    let direct = tree
+        .read(&RelPath::new("src/child.rs").expect("path"), 1 << 20)
+        .expect_err("not UTF-8");
+    assert!(matches!(direct, TreeError::NotUtf8 { .. }), "{direct:?}");
+
+    let error = Workspace::load_with(&tree, &["."], &LoadOptions::default()).expect_err("refused");
+    assert!(
+        matches!(&error.kind, LoadErrorKind::Tree(inner) if matches!(**inner, TreeError::NotUtf8 { .. })),
+        "{error}"
+    );
+    assert!(error.to_string().contains("src/child.rs"), "{error}");
+    assert_eq!(error.line, Some(1), "the line of `mod child;`: {error}");
+
+    // The neighbour: the same file in UTF-8 loads.
+    fs::write(
+        scratch.path("root/src/child.rs"),
+        "// caf\u{e9}\npub fn f() {}\n",
+    )
+    .expect("write");
+    let tree = DiskTree::new(scratch.path("root")).expect("tree");
+    let ws = Workspace::load(&tree, &["."]).expect("UTF-8 loads");
+    assert_eq!(item(&ws, "demo::child::f").name_line, 2);
+}
