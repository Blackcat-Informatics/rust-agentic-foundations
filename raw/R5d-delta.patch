+        let (UseKind::Named { segs, .. } | UseKind::Glob { segs }) = &decl.kind;
+        !decl.leading_colon
+            && segs.first().is_some_and(|first| first == name)
+            && !matches!(name, "crate" | "self" | "super")
+            && self.edition(decl.module) != 2015
+            && self.in_use_prelude(decl.module, name, decl.test)
