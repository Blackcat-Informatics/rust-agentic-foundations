+    /// let site = |path: &str| ws.resolve(path).map(|found| found.sites[0]);
+    /// let reached = ws.reachable(&[Node::Item(site("demo::run")?)])?;
+    /// assert!(reached.contains(Node::Item(site("demo::helper")?)));
