+    fn with(code: &'static str, lib: &str, src: &[(&str, &str)]) -> Spec {
+        let mut spec = strict_ready();
+        spec.code = code;
+        spec.lib = lib.to_string();
+        spec.src = src.iter().map(|(p, t)| (p.to_string(), t.to_string())).collect();
+        spec
+    }
+
+    fn probe(name: &str, spec: &Spec, edit: &dyn Fn(&Fixture), complete: bool) {
+        let fixture = Fixture::real(spec);
+        let pristine = fixture.snapshot();
+        edit(&fixture);
+        assert_ne!(fixture.snapshot(), pristine, "{name}: the edit changed nothing");
+        fixture.resync();
+        fixture.assess();
+        let mut out = format!("=== {name}\n");
+        let before = fixture.snapshot();
+        match fixture.lifecycle_with(Strictness::Strict).reconcile("shape") {
+            Ok(owed) => {
+                if owed.is_empty() {
+                    out.push_str("  reconcile(strict): no obligation\n");
+                }
+                for o in owed.obligations() {
+                    out.push_str(&format!("  reconcile(strict): {o}\n"));
+                }
+            }
+            Err(e) => out.push_str(&format!("  reconcile(strict) ERROR: {e}\n")),
+        }
+        if complete {
+            match fixture.lifecycle_with(Strictness::Strict).complete("shape") {
+                Ok(c) => {
+                    out.push_str(&format!("  complete(strict): {}\n", c.headline()));
+                    if !c.is_completed() {
+                        for l in c.to_string().lines().skip(1) {
+                            out.push_str(&format!("    {l}\n"));
+                        }
+                        out.push_str(&format!(
+                            "    tree unchanged: {}\n",
+                            fixture.snapshot() == before
+                        ));
+                    }
+                }
+                Err(e) => out.push_str(&format!("  complete(strict) ERROR: {e}\n")),
+            }
+        }
+        println!("{out}");
+    }
