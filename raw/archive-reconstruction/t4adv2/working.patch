+        let mut out = String::from("=== Q04 symlinked module file in the base\n");
+        for (label, text) in [("plain comment", "// note\npub fn round() -> u32 {\n    1\n}\n"), ("body edit", "// note\npub fn round() -> u32 {\n    2\n}\n")] {
+            put(fixture.root(), "real/geo.rs", text);
