    fn exercise(data: &[u8]) {
        SELF_CHECK.call_once(workspace_input::self_check);
        let Some(tree) = workspace_input::tree(data) else {
            return;
        };
        if let Ok(workspace) = Workspace::load(&tree, &["."]) {
            std::hint::black_box(workspace_input::exercise(&workspace));
        }
    }
