+            prefix.push_str(part);
+            if self.literal.contains(&prefix) {
+                return true;
+            }
+        }
+        if self.wildcard.is_empty() {
+            return false;
+        }
+        let chars: Vec<Vec<char>> = parts.iter().map(|part| part.chars().collect()).collect();
+        self.wildcard
+            .iter()
+            .any(|pattern| pattern.matches_prefix(&chars))
+    }
