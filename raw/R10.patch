+
+impl Excludes {
+    fn new(patterns: Vec<Pattern>) -> Self {
+        let mut literal = HashSet::new();
+        let mut wildcard = Vec::new();
+        for pattern in patterns {
+            match pattern.literal_key() {
+                Some(key) => {
+                    literal.insert(key);
