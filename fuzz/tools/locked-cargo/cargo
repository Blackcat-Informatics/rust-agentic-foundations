# cargo-fuzz launches Cargo by name and does not expose its lock flag.
set -euo pipefail
: "${RAF_FUZZ_CARGO:?set the outer Cargo executable in the fuzz gate}"
case "${1:-}" in
    build|metadata|run) exec "$RAF_FUZZ_CARGO" "$1" --locked "${@:2}" ;;
    -V|--version) exec "$RAF_FUZZ_CARGO" "$@" ;;
    *) echo "fuzz gate: unexpected Cargo command '${1:-}'" >&2; exit 1 ;;
esac
